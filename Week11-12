import matplotlib.pyplot as plt
from sklearn.datasets import load_digits
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE
from sklearn.preprocessing import StandardScaler

# 1. Load the dataset (1,797 images, each with 64 pixel features)
digits = load_digits()
X = digits.data
y = digits.target

# 2. Scale features (essential for PCA)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

print(f"Data shape before reduction: {X_scaled.shape}")

# Run PCA (reduces 64 features down to 2)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

# Run t-SNE (reduces 64 features down to 2)
tsne = TSNE(n_components=2, perplexity=30, random_state=42)
X_tsne = tsne.fit_transform(X_scaled)

print("Dimensionality reduction complete!")

plt.figure(figsize=(12, 5))

# Plot PCA results
plt.subplot(1, 2, 1)
scatter_pca = plt.scatter(
    X_pca[:, 0], X_pca[:, 1], c=y, cmap="tab10", alpha=0.7, s=15
)
plt.title("PCA Projection")
plt.colorbar(scatter_pca)

# Plot t-SNE results
plt.subplot(1, 2, 2)
scatter_tsne = plt.scatter(
    X_tsne[:, 0], X_tsne[:, 1], c=y, cmap="tab10", alpha=0.7, s=15
)
plt.title("t-SNE Projection")
plt.colorbar(scatter_tsne)

plt.tight_layout()
plt.show()
